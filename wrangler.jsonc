{
  "name": "southern-nutrition",
  "main": "worker.js",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "southern-nutrition-db",
      "database_id": "775f9d64-1acf-411d-b32e-1361ff0550d6"
    }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "Ashley.lewis0311@icloud.com",
      "allowed_sender_addresses": [
        "orders@getsouthernnutrition.com"
      ]
    }
  ]
}
